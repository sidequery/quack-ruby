#!/usr/bin/env ruby
require "rubygems"

gemspec = Dir["*.gemspec"].fetch(0)
spec = Gem::Specification.load(gemspec)
current = spec.version.to_s
abort "release versions must use X.Y.Z" unless current.match?(/\A\d+\.\d+\.\d+\z/)
tag = ENV.fetch("RELEASE_TAG", "")

def git(*args)
  system("git", *args, exception: true)
end

if tag.empty?
  abort "create releases from main" unless ENV.fetch("GITHUB_REF") == "refs/heads/main"
  parts = current.split(".").map(&:to_i)
  index = %w[major minor patch].index(ENV.fetch("BUMP")) or abort "unknown version bump"
  parts[index] += 1
  ((index + 1)...3).each { |position| parts[position] = 0 }
  version = parts.join(".")
  tag = "v#{version}"
  changes = {gemspec => [/spec\.version = "#{Regexp.escape(current)}"/, "spec.version = \"#{version}\""]}
  Dir["**/Gemfile*.lock"].each do |path|
    changes[path] = [/^(    #{Regexp.escape(spec.name)} \()#{Regexp.escape(current)}(\))$/, "\\1#{version}\\2"]
  end
  if spec.name == "quack-ruby"
    changes["lib/quack.rb"] = [/VERSION = "#{Regexp.escape(current)}"/, "VERSION = \"#{version}\""]
    changes["ext/quack/Cargo.toml"] = [/^version = "#{Regexp.escape(current)}"/, "version = \"#{version}\""]
    changes["ext/quack/Cargo.lock"] = [/(name = "quack-ruby"\nversion = ")#{Regexp.escape(current)}(")/, "\\1#{version}\\2"]
  end
  changes.each do |path, (pattern, replacement)|
    source = File.read(path)
    abort "missing current version in #{path}" unless source.match?(pattern)
    File.write(path, source.sub(pattern, replacement))
  end
  git("diff", "--check")
  git("config", "user.name", "github-actions[bot]")
  git("config", "user.email", "github-actions[bot]@users.noreply.github.com")
  git("add", "--", *changes.keys)
  git("commit", "-m", "Release #{tag}")
  git("tag", "-a", tag, "-m", "Release #{tag}")
  git("push", "--atomic", "origin", "HEAD:main", "refs/tags/#{tag}")
else
  abort "release tag does not match source version" unless tag == "v#{current}"
  tagged_sha = IO.popen(["git", "rev-parse", "refs/tags/#{tag}^{commit}"], &:read).strip
  head_sha = IO.popen(["git", "rev-parse", "HEAD"], &:read).strip
  abort "checkout does not match release tag" unless tagged_sha == head_sha
  version = current
end

sha = IO.popen(["git", "rev-parse", "HEAD"], &:read).strip
File.open(ENV.fetch("GITHUB_OUTPUT"), "a") do |output|
  output.puts "version=#{version}", "tag=#{tag}", "sha=#{sha}"
end
